<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <com.dshare.app.view.StarfieldView
        android:id="@+id/starfield"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ===================== WAITING SCREEN ===================== -->
    <FrameLayout
        android:id="@+id/waitingScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <!-- Centered: waiting title + pairing code + small QR -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_waiting_title"
                android:textAppearance="@style/Text.Title"
                android:textSize="26sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="@drawable/shape_status_dot" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/status_waiting"
                    android:textAppearance="@style/Text.Body" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.DShare.Card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:padding="22dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_code"
                            android:textAppearance="@style/Text.Label" />

                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp">

                            <TextView
                                android:id="@+id/codeText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/shape_code_chip"
                                android:fontFamily="monospace"
                                android:letterSpacing="0.35"
                                android:paddingHorizontal="22dp"
                                android:paddingVertical="12dp"
                                android:textColor="@color/accent_dark"
                                android:textSize="30sp"
                                android:textStyle="bold"
                                android:visibility="invisible"
                                tools:text="482913" />

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/codeLoadingSpinner"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:indeterminate="true"
                                app:indicatorColor="@color/accent"
                                app:indicatorSize="28dp"
                                app:trackColor="@android:color/transparent"
                                app:trackCornerRadius="14dp"
                                app:trackThickness="3dp" />
                        </FrameLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRegenerate"
                            style="@style/Widget.DShare.Button.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="@string/action_regenerate"
                            app:icon="@drawable/ic_refresh"
                            app:iconGravity="textStart"
                            app:iconTint="@color/text_secondary" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="20dp"
                        android:background="@drawable/shape_qr_container"
                        android:padding="8dp">

                        <ImageView
                            android:id="@+id/qrImage"
                            android:layout_width="88dp"
                            android:layout_height="88dp"
                            android:contentDescription="@null"
                            android:visibility="invisible" />

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/qrLoadingSpinner"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:indeterminate="true"
                            app:indicatorColor="@color/accent"
                            app:indicatorSize="28dp"
                            app:trackColor="@android:color/transparent"
                            app:trackCornerRadius="14dp"
                            app:trackThickness="3dp" />
                    </FrameLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Bottom: address, kept small and out of the way -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="18dp"
            android:background="@drawable/shape_icon_button_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/addressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/text_secondary"
                android:textIsSelectable="true"
                android:textSize="13sp"
                tools:text="https://192.168.0.12:53211" />

            <ImageButton
                android:id="@+id/btnCopy"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="10dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/action_copy"
                android:padding="5dp"
                android:src="@drawable/ic_copy" />
        </LinearLayout>
    </FrameLayout>

    <!-- ===================== CONNECTING OVERLAY ===================== -->
    <FrameLayout
        android:id="@+id/connectingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/connectingSpinner"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:indeterminate="true"
                app:indicatorColor="@color/accent"
                app:indicatorSize="56dp"
                app:trackColor="@android:color/transparent"
                app:trackCornerRadius="24dp"
                app:trackThickness="5dp" />

            <TextView
                android:id="@+id/connectingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/status_connecting"
                android:textAppearance="@style/Text.Body"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- ===================== SUCCESS OVERLAY ===================== -->
    <FrameLayout
        android:id="@+id/successOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/successCheck"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_check_circle" />

            <TextView
                android:id="@+id/successText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:alpha="0"
                android:text="@string/status_connected"
                android:textAppearance="@style/Text.Title"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- ===================== STREAMING SCREEN ===================== -->
    <FrameLayout
        android:id="@+id/streamingContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="invisible">

        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/surfaceRenderer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

</FrameLayout>
